{
  "expo": {
    "name": "Nonnegotiable",
    "slug": "nonnegotiable-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nonnegotiable",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selfnamed.nonnegotiablegunta"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.example.nonnegotiable"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "./plugins/withNoApsEntitlement"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "325d7409-3f36-45d7-9e90-92312f13c470"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/325d7409-3f36-45d7-9e90-92312f13c470"
    }
  }
}
